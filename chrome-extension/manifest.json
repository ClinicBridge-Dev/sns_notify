{
  "manifest_version": 3,
  "name": "CB 메시지 감시",
  "version": "0.1.0",
  "description": "인스타그램 DM 목록(Primary/General)에서 새 메시지가 왔는지만 확인해 수집기에 알립니다. 대화방은 열지 않습니다.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*", "http://localhost/*", "http://127.0.0.1/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://www.instagram.com/*"], "js": ["parse.js", "content.js"], "run_at": "document_idle" }
  ],
  "action": { "default_popup": "popup.html", "default_title": "CB 메시지 감시" },
  "options_page": "options.html"
}
